{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"customTemplates": [
		{
			"name": "page-no-title",
			"postTypes": [
				"page"
			],
			"title": "Page (no title)"
		}
	],
	"settings": {
		"appearanceTools": true,
		"color": {
			"defaultDuotone": false,
			"defaultGradients": false,
			"defaultPalette": false,
			"duotone": [
				{
					"colors": [
						"#000000",
						"#FFFFFF"
					],
					"name": "Black and white",
					"slug": "duotone-1"
				},
				{
					"colors": [
						"#ff6b00",
						"#fff1e5"
					],
					"name": "Orange",
					"slug": "orange"
				}
			],
			"gradients": [
				{
					"gradient": "radial-gradient(rgb(17,32,64) 0%,rgb(7,14,32) 100%)",
					"name": "Hero",
					"slug": "hero"
				}
			],
			"palette": [
				{
					"color": "#f5f7fb",
					"name": "Color 1",
					"slug": "theme-1"
				},
				{
					"color": "#070e20",
					"name": "Color 2",
					"slug": "theme-2"
				},
				{
					"color": "#ff6b00",
					"name": "Color 3",
					"slug": "theme-3"
				},
				{
					"color": "#070f220f",
					"name": "Color 4",
					"slug": "theme-4"
				},
				{
					"color": "#ffffff",
					"name": "Color 5",
					"slug": "theme-5"
				},
				{
					"color": "#9fa7bc",
					"name": "Color 6",
					"slug": "custom-color-6"
				},
				{
					"color": "#4a5267",
					"name": "Color 7",
					"slug": "custom-color-7"
				},
				{
					"color": "#fff1e5",
					"name": "Color 8",
					"slug": "custom-color-8"
				},
				{
					"color": "#ffffff17",
					"name": "Color 9",
					"slug": "custom-color-9"
				},
				{
					"color": "#953f00",
					"name": "Color 10",
					"slug": "custom-color-10"
				}
			]
		},
		"layout": {
			"contentSize": "680px",
			"wideSize": "1100px"
		},
		"spacing": {
			"defaultSpacingSizes": false,
			"spacingSizes": [
				{
					"name": "2X-Small",
					"size": "8px",
					"slug": "20"
				},
				{
					"name": "X-Small",
					"size": "16px",
					"slug": "30"
				},
				{
					"name": "Small",
					"size": "clamp(24px, 2.33vw, 32px)",
					"slug": "40"
				},
				{
					"name": "Regular",
					"size": "clamp(32px, 3.49vw, 48px)",
					"slug": "50"
				},
				{
					"name": "Large",
					"size": "clamp(48px, 4.65vw, 64px)",
					"slug": "60"
				},
				{
					"name": "X-Large",
					"size": "clamp(64px, 6.98vw, 96px)",
					"slug": "70"
				},
				{
					"name": "2X-Large",
					"size": "clamp(96px, 9.31vw, 128px)",
					"slug": "80"
				}
			],
			"units": [
				"%",
				"px",
				"em",
				"rem",
				"vh",
				"dvh",
				"vw"
			]
		},
		"typography": {
			"defaultFontSizes": false,
			"fluid": true,
			"fontFamilies": [
				{
					"fontFace": [
						{
							"fontFamily": "\"Plus Jakarta Sans\"",
							"fontStyle": "normal",
							"fontWeight": "300",
							"src": [
								"file:./assets/fonts/plus-jakarta-sans/plus-jakarta-sans-300-normal.woff2"
							]
						},
						{
							"fontFamily": "\"Plus Jakarta Sans\"",
							"fontStyle": "normal",
							"fontWeight": "400",
							"src": [
								"file:./assets/fonts/plus-jakarta-sans/plus-jakarta-sans-400-normal.woff2"
							]
						},
						{
							"fontFamily": "\"Plus Jakarta Sans\"",
							"fontStyle": "normal",
							"fontWeight": "500",
							"src": [
								"file:./assets/fonts/plus-jakarta-sans/plus-jakarta-sans-500-normal.woff2"
							]
						},
						{
							"fontFamily": "\"Plus Jakarta Sans\"",
							"fontStyle": "normal",
							"fontWeight": "600",
							"src": [
								"file:./assets/fonts/plus-jakarta-sans/plus-jakarta-sans-600-normal.woff2"
							]
						},
						{
							"fontFamily": "\"Plus Jakarta Sans\"",
							"fontStyle": "normal",
							"fontWeight": "700",
							"src": [
								"file:./assets/fonts/plus-jakarta-sans/plus-jakarta-sans-700-normal.woff2"
							]
						},
						{
							"fontFamily": "\"Plus Jakarta Sans\"",
							"fontStyle": "italic",
							"fontWeight": "300",
							"src": [
								"file:./assets/fonts/plus-jakarta-sans/plus-jakarta-sans-300-italic.woff2"
							]
						},
						{
							"fontFamily": "\"Plus Jakarta Sans\"",
							"fontStyle": "italic",
							"fontWeight": "400",
							"src": [
								"file:./assets/fonts/plus-jakarta-sans/plus-jakarta-sans-400-italic.woff2"
							]
						},
						{
							"fontFamily": "\"Plus Jakarta Sans\"",
							"fontStyle": "italic",
							"fontWeight": "500",
							"src": [
								"file:./assets/fonts/plus-jakarta-sans/plus-jakarta-sans-500-italic.woff2"
							]
						},
						{
							"fontFamily": "\"Plus Jakarta Sans\"",
							"fontStyle": "italic",
							"fontWeight": "600",
							"src": [
								"file:./assets/fonts/plus-jakarta-sans/plus-jakarta-sans-600-italic.woff2"
							]
						},
						{
							"fontFamily": "\"Plus Jakarta Sans\"",
							"fontStyle": "italic",
							"fontWeight": "700",
							"src": [
								"file:./assets/fonts/plus-jakarta-sans/plus-jakarta-sans-700-italic.woff2"
							]
						}
					],
					"fontFamily": "\"Plus Jakarta Sans\", sans-serif",
					"name": "Plus Jakarta Sans",
					"slug": "plus-jakarta-sans"
				},
				{
					"fontFace": [
						{
							"fontFamily": "Newsreader",
							"fontStyle": "normal",
							"fontWeight": "300",
							"src": [
								"file:./assets/fonts/newsreader/newsreader-300-normal.woff2"
							]
						},
						{
							"fontFamily": "Newsreader",
							"fontStyle": "normal",
							"fontWeight": "400",
							"src": [
								"file:./assets/fonts/newsreader/newsreader-400-normal.woff2"
							]
						},
						{
							"fontFamily": "Newsreader",
							"fontStyle": "normal",
							"fontWeight": "500",
							"src": [
								"file:./assets/fonts/newsreader/newsreader-500-normal.woff2"
							]
						},
						{
							"fontFamily": "Newsreader",
							"fontStyle": "normal",
							"fontWeight": "600",
							"src": [
								"file:./assets/fonts/newsreader/newsreader-600-normal.woff2"
							]
						},
						{
							"fontFamily": "Newsreader",
							"fontStyle": "normal",
							"fontWeight": "700",
							"src": [
								"file:./assets/fonts/newsreader/newsreader-700-normal.woff2"
							]
						},
						{
							"fontFamily": "Newsreader",
							"fontStyle": "italic",
							"fontWeight": "300",
							"src": [
								"file:./assets/fonts/newsreader/newsreader-300-italic.woff2"
							]
						},
						{
							"fontFamily": "Newsreader",
							"fontStyle": "italic",
							"fontWeight": "400",
							"src": [
								"file:./assets/fonts/newsreader/newsreader-400-italic.woff2"
							]
						},
						{
							"fontFamily": "Newsreader",
							"fontStyle": "italic",
							"fontWeight": "500",
							"src": [
								"file:./assets/fonts/newsreader/newsreader-500-italic.woff2"
							]
						},
						{
							"fontFamily": "Newsreader",
							"fontStyle": "italic",
							"fontWeight": "600",
							"src": [
								"file:./assets/fonts/newsreader/newsreader-600-italic.woff2"
							]
						},
						{
							"fontFamily": "Newsreader",
							"fontStyle": "italic",
							"fontWeight": "700",
							"src": [
								"file:./assets/fonts/newsreader/newsreader-700-italic.woff2"
							]
						}
					],
					"fontFamily": "Newsreader, serif",
					"name": "Newsreader",
					"slug": "newsreader"
				}
			],
			"fontSizes": [
				{
					"fluid": false,
					"name": "Small",
					"size": "1rem",
					"slug": "small"
				},
				{
					"fluid": {
						"max": "1.25rem",
						"min": "1.125rem"
					},
					"name": "Medium",
					"size": "1.25rem",
					"slug": "medium"
				},
				{
					"fluid": {
						"max": "1.625rem",
						"min": "1.4375rem"
					},
					"name": "Large",
					"size": "1.625rem",
					"slug": "large"
				},
				{
					"fluid": {
						"max": "2rem",
						"min": "1.625rem"
					},
					"name": "X-Large",
					"size": "2rem",
					"slug": "x-large"
				},
				{
					"fluid": {
						"max": "2.5625rem",
						"min": "2rem"
					},
					"name": "2X-Large",
					"size": "2.5625rem",
					"slug": "2-x-large"
				},
				{
					"name": "X-Small",
					"size": "0.88rem",
					"slug": "custom-1"
				},
				{
					"name": "3X-Large",
					"size": "6rem",
					"slug": "3-x-large"
				}
			],
			"writingMode": true
		},
		"useRootPaddingAwareAlignments": true
	},
	"styles": {
		"blocks": {
			"core/avatar": {
				"border": {
					"radius": {
						"bottomLeft": "999px",
						"bottomRight": "999px",
						"topLeft": "999px",
						"topRight": "999px"
					}
				}
			},
			"core/button": {
				":active": {
					"color": {
						"background": "color-mix(in srgb, var(--wp--preset--color--theme-2) 85%, transparent)",
						"text": "var(--wp--preset--color--theme-1)"
					}
				},
				":focus": {
					"color": {
						"background": "color-mix(in srgb, var(--wp--preset--color--theme-2) 85%, transparent)",
						"text": "var(--wp--preset--color--theme-1)"
					},
					"outline": {
						"offset": "4px"
					}
				},
				":hover": {
					"color": {
						"background": "color-mix(in srgb, var(--wp--preset--color--theme-2) 85%, transparent)",
						"text": "var(--wp--preset--color--theme-1)"
					}
				},
				"color": {
					"background": "var(--wp--preset--color--theme-3)",
					"text": "var(--wp--preset--color--theme-2)"
				},
				"elements": {
					"link": {
						"color": {
							"text": "var(--wp--preset--color--theme-2)"
						}
					}
				},
				"typography": {
					"fontStyle": "normal",
					"fontWeight": "700"
				},
				"variations": {
					"outline": {
						":active": {
							"color": {
								"background": "color-mix(in srgb, var(--wp--preset--color--theme-2) 85%, transparent)",
								"text": "var(--wp--preset--color--theme-1)"
							}
						},
						":focus": {
							"color": {
								"background": "color-mix(in srgb, var(--wp--preset--color--theme-2) 85%, transparent)",
								"text": "var(--wp--preset--color--theme-1)"
							},
							"outline": {
								"offset": "4px"
							}
						},
						":hover": {
							"color": {
								"background": "color-mix(in srgb, var(--wp--preset--color--theme-2) 85%, transparent)",
								"text": "var(--wp--preset--color--theme-1)"
							}
						},
						"border": {
							"bottom": {
								"color": "currentColor",
								"style": "solid",
								"width": "1px"
							},
							"left": {
								"color": "currentColor",
								"style": "solid",
								"width": "1px"
							},
							"right": {
								"color": "currentColor",
								"style": "solid",
								"width": "1px"
							},
							"top": {
								"color": "currentColor",
								"style": "solid",
								"width": "1px"
							}
						}
					}
				}
			},
			"core/code": {
				"border": {
					"bottom": {
						"style": "none",
						"width": "0px"
					},
					"left": {
						"style": "none",
						"width": "0px"
					},
					"radius": {
						"bottomLeft": "30px",
						"bottomRight": "30px",
						"topLeft": "30px",
						"topRight": "30px"
					},
					"right": {
						"style": "none",
						"width": "0px"
					},
					"top": {
						"style": "none",
						"width": "0px"
					}
				},
				"color": {
					"background": "var(--wp--preset--color--theme-4)"
				},
				"spacing": {
					"padding": {
						"bottom": "var(--wp--preset--spacing--50)",
						"left": "var(--wp--preset--spacing--50)",
						"right": "var(--wp--preset--spacing--50)",
						"top": "var(--wp--preset--spacing--50)"
					}
				},
				"typography": {
					"fontFamily": "monospace"
				}
			},
			"core/comment-content": {
				"css": "& p{margin-top:var(--wp--preset--spacing--40); margin-bottom:0;} & > :first-child{margin-top:0;}"
			},
			"core/image": {
				"border": {
					"radius": {
						"bottomLeft": "30px",
						"bottomRight": "30px",
						"topLeft": "30px",
						"topRight": "30px"
					}
				}
			},
			"core/latest-comments": {
				"css": "& .wp-block-latest-comments__comment-date{font-size: inherit;} & .wp-block-latest-comments__comment-excerpt p {font-size:inherit !important;margin: 0 !important;}"
			},
			"core/latest-posts": {
				"css": "& .wp-block-latest-posts__post-author{font-size:inherit;} & .wp-block-latest-posts__post-date{font-size:inherit;} & li:not(:first-of-type) {margin-top: var(--wp--style--block-gap);} & .wp-block-latest-posts__post-excerpt{margin-top: var(--wp--style--block-gap);} & .wp-block-latest-posts__post-full-content{margin-top: var(--wp--style--block-gap);}"
			},
			"core/list": {
				"css": "& li{margin-top: 0.5rem;}"
			},
			"core/navigation": {
				"elements": {
					"link": {
						":hover": {
							"typography": {
								"textDecoration": "underline"
							}
						},
						"typography": {
							"textDecoration": "none"
						}
					}
				},
				"typography": {
					"fontSize": "var(--wp--preset--font-size--small)"
				}
			},
			"core/navigation-submenu": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--small)"
				}
			},
			"core/paragraph": {
				"typography": {
					"lineHeight": "1.5"
				}
			},
			"core/post-author": {
				"css": "& .wp-block-post-author__bio{font-size:inherit;margin:0;} & .wp-block-post-author__byline{font-size:inherit;}"
			},
			"core/post-comments-form": {
				"css": "& textarea, input:not([type=submit]){border-color: var(--wp--preset--color--theme-4);} & input[type=checkbox]{margin:0 .5rem 0 0 !important;} & label {font-size: var(--wp--preset--font-size--small);} & .comment-form > * {margin-top: var(--wp--style--block-gap);margin-bottom: 0;}"
			},
			"core/post-content": {
				"elements": {
					"heading": {
						"spacing": {
							"margin": {
								"top": "calc(var(--wp--style--block-gap) * 2)"
							}
						}
					}
				}
			},
			"core/post-excerpt": {
				"css": "& .wp-block-post-excerpt__excerpt {line-height: inherit;} & .wp-block-post-excerpt__more-link {font-weight: 700;}"
			},
			"core/post-navigation-link": {
				"elements": {
					"link": {
						":hover": {
							"typography": {
								"textDecoration": "underline"
							}
						},
						"typography": {
							"textDecoration": "none"
						}
					}
				}
			},
			"core/post-terms": {
				"css": "& a {white-space: nowrap;}",
				"typography": {
					"fontSize": "var(--wp--preset--font-size--custom-1)",
					"fontStyle": "normal",
					"fontWeight": "600",
					"letterSpacing": "0.06em",
					"textTransform": "uppercase"
				}
			},
			"core/post-title": {
				"elements": {
					"link": {
						":hover": {
							"typography": {
								"textDecoration": "underline"
							}
						},
						"typography": {
							"textDecoration": "none"
						}
					}
				}
			},
			"core/pullquote": {
				"border": {
					"radius": {
						"bottomLeft": "30px",
						"bottomRight": "30px",
						"topLeft": "30px",
						"topRight": "30px"
					}
				},
				"color": {
					"background": "var(--wp--preset--color--theme-5)",
					"text": "var(--wp--preset--color--theme-2)"
				},
				"css": "& p:last-of-type {margin-bottom: var(--wp--preset--spacing--40);}",
				"elements": {
					"link": {
						"color": {
							"text": "var(--wp--preset--color--theme-2)"
						}
					}
				},
				"spacing": {
					"margin": {
						"left": "0",
						"right": "0"
					},
					"padding": {
						"bottom": "var(--wp--preset--spacing--60)",
						"left": "var(--wp--preset--spacing--60)",
						"right": "var(--wp--preset--spacing--60)",
						"top": "var(--wp--preset--spacing--60)"
					}
				},
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--newsreader)",
					"fontSize": "var(--wp--preset--font-size--x-large)",
					"textAlign": "left"
				}
			},
			"core/query-pagination": {
				"elements": {
					"link": {
						":hover": {
							"typography": {
								"textDecoration": "underline"
							}
						},
						"typography": {
							"textDecoration": "none"
						}
					}
				}
			},
			"core/query-pagination-next": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--small)"
				}
			},
			"core/query-pagination-numbers": {
				"css": "{display:flex} & .page-numbers{padding:0 4px;} & a{text-decoration:inherit !important;}",
				"typography": {
					"fontSize": "var(--wp--preset--font-size--small)"
				}
			},
			"core/query-pagination-previous": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--small)"
				}
			},
			"core/quote": {
				"border": {
					"left": {
						"color": "var(--wp--preset--color--theme-4)",
						"style": "solid",
						"width": "2px"
					}
				},
				"elements": {
					"cite": {
						"css": "& {font-size:var(--wp--preset--font-size--small);}"
					}
				},
				"spacing": {
					"margin": {
						"left": "var(--wp--preset--spacing--30)"
					},
					"padding": {
						"left": "var(--wp--preset--spacing--40)"
					}
				}
			},
			"core/search": {
				"css": "& .wp-block-search__input{border-color:var(--wp--preset--color--theme-4);} &.wp-block-search__button-inside .wp-block-search__inside-wrapper {border-color:var(--wp--preset--color--theme-4);}"
			},
			"core/separator": {
				"border": {
					"color": "currentColor",
					"style": "solid",
					"width": "0 0 1px 0"
				},
				"color": {
					"background": "var(--wp--preset--color--theme-4)",
					"text": "var(--wp--preset--color--theme-2)"
				},
				"variations": {
					"wide": {
						"css": " &:not(.alignfull){max-width: var(--wp--style--global--wide-size) !important;}"
					}
				}
			},
			"core/site-tagline": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--small)"
				}
			},
			"core/site-title": {
				"elements": {
					"link": {
						":hover": {
							"typography": {
								"textDecoration": "underline"
							}
