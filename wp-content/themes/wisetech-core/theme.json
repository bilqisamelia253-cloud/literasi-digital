{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "layout": {
      "contentSize": "760px",
      "wideSize": "1180px"
    },
    "color": {
      "defaultPalette": false,
      "palette": [
        { "slug": "ink", "name": "Ink", "color": "#172033" },
        { "slug": "muted", "name": "Muted", "color": "#667085" },
        { "slug": "accent", "name": "Accent", "color": "#2563eb" },
        { "slug": "surface", "name": "Surface", "color": "#f7f9fc" },
        { "slug": "white", "name": "White", "color": "#ffffff" }
      ]
    },
    "spacing": {
      "units": ["px", "rem", "%", "vw", "vh"]
    },
    "typography": {
      "fluid": true,
      "fontFamilies": [
        {
          "fontFamily": "ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif",
          "name": "System Sans",
          "slug": "system-sans"
        },
        {
          "fontFamily": "ui-monospace, SFMono-Regular, Menlo, Consolas, monospace",
          "name": "System Mono",
          "slug": "system-mono"
        }
      ],
      "fontSizes": [
        { "slug": "small", "size": "0.875rem", "name": "Small" },
        { "slug": "medium", "size": "1rem", "name": "Medium" },
        { "slug": "large", "size": "1.25rem", "name": "Large" },
        { "slug": "x-large", "size": "2rem", "name": "Extra Large" }
      ]
    }
  },
  "styles": {
    "color": {
      "background": "#ffffff",
      "text": "#172033"
    },
    "typography": {
      "fontFamily": "var:preset|font-family|system-sans",
      "lineHeight": "1.7"
    },
    "elements": {
      "link": {
        "color": { "text": "#2563eb" }
      },
      "heading": {
        "typography": { "fontWeight": "750", "lineHeight": "1.2" },
        "color": { "text": "#172033" }
      }
    }
  }
}
